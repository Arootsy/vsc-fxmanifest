{
    "fxmanifest": {
        "prefix": "fxmanifest",
        "body": [
            "fx_version \"adamant\"",
            "game \"gta5\"",
            "use_fxv2_oal \"yes\"",
            "lua54 \"yes\"",
            "",
            "name \"${1:name}\"",
            "author \"${2:author}\"",
            "version \"1.0.0\"",
            "",
            "client_scripts { \"client/**/*.lua\" }",
            "server_scripts { \"server/**/*.lua\", \"@oxmysql/lib/MySQL.lua\" }",
            "shared_scripts {",
            "    \"${3:@es_extended/imports.lua}\", -- Optional",
            "    \"${4:@ox_lib/init.lua}\", -- Optional",
            "    \"data/**/*.lua\" -- For the config",
            "}"
        ],
        "description": "Inserts fxmanifest for FiveM with optional WebUI support",
        "scope": "file"
    }
}