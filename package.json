{
    "name": "fxmanifest-snippet",
    "displayName": "FXManifest Snippet",
    "description": "Are you tired of typing new manifests for FiveM? Here's the solution! Download this extension, type fxmanifest, and boom. You've created an fxmanifest.lua within seconds!",
    "version": "1.0.4",
    "publisher": "Zweetstreep",
    "icon": "images/icon.png",
    "engines": {
        "vscode": "^1.0.0"
    },
    "categories": [
        "Snippets"
    ],
    "contributes": {
        "snippets": [
            {
                "language": "lua",
                "path": "./src/fxmanifest.json"
            }
        ]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Arootsy/vsc-fxmanifest"
    }
}